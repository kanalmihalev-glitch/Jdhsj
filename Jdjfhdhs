        if not hrp then task.wait(0.3) continue end
        if not invisible then applyInvisible() end
        local coin = findNearestCoin(visited) 
        if not coin then task.wait(0.3) continue end
        if not isCoinValid(coin) then refreshCoinCache() task.wait(0.1) continue end
        local target = getCoinTarget(coin)
        if flyTo(target, FLY_SPEED) and isCoinValid(coin) then
            fireTouch(coin) 
            task.wait(PAUSE_AT_COIN)
            if not isCoinValid(coin) then
                visited[coin] = true 
                collected = collected + 1 
                collectedSinceReset = collectedSinceReset + 1
                if collectedSinceReset >= BAG_LIMIT then 
                    collectedSinceReset = 0 
                    visited = {} 
                    triggerBagFull() 
                    task.wait(1) 
                end
            end
        end
    end
end

local function startFarm() 
    if farming then return end 
    farming = true 
    if not killing and not tping then startNoclip() end 
    applyInvisible() 
    task.spawn(farmLoop) 
end

local function stopFarm() 
    farming = false 
    if not killing and not tping and not flying then 
        stopNoclip() 
        removeInvisible() 
    end 
end

-- === FARM TP ===
local function tpFarmLoop()
    collectedTP = 0 
    visitedTP = {} 
    collectedTPSinceReset = 0 
    refreshCoinCache()
    while tping do
        if not LocalPlayer.Character then task.wait(1) continue end
        refreshHrp() 
        if not hrp then task.wait(0.3) continue end
        if not invisible then applyInvisible() end
        if not hubPosition then hubPosition = hrp.Position end
        local coin = findNearestCoin(visitedTP) 
        if not coin then task.wait(0.5) continue end
        if not isCoinValid(coin) then refreshCoinCache() task.wait(0.1) continue end
        local target = getCoinTarget(coin) 
        hrp.CFrame = CFrame.new(target) 
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        task.wait(0.05)
        if isCoinValid(coin) then
            fireTouch(coin) 
            task.wait(TP_COIN_TIME)
            if not isCoinValid(coin) then
                visitedTP[coin] = true 
                collectedTP = collectedTP + 1 
                collectedTPSinceReset = collectedTPSinceReset + 1
                if collectedTPSinceReset >= BAG_LIMIT then 
                    collectedTPSinceReset = 0 
                    visitedTP = {} 
                    triggerBagFull() 
                    task.wait(1) 
                end
            end
        end
        if hubPosition and tping then 
            hrp.CFrame = CFrame.new(hubPosition) 
            task.wait(TP_HUB_TIME) 
        end
    end
end

local function startTp() 
    if tping then return end 
    tping = true 
    applyInvisible() 
    task.spawn(tpFarmLoop) 
end

local function stopTp() 
    tping = false 
    if not killing and not farming and not flying then 
