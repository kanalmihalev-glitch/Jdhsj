-- === COIN SCAN ===
local function isCoinValid(part)
    if not part or not part:IsA("BasePart") then return false end
    if not part.Parent then return false end
    if part.Transparency >= 1 then return false end
    if not part.Name:lower():find("coin") then return false end
    return true
end

local function refreshCoinCache()
    coinCache = {}
    for _, obj in pairs(workspace:GetDescendants()) do 
        if isCoinValid(obj) then 
            table.insert(coinCache, obj) 
        end 
    end
    lastScan = tick()
end

local function findNearestCoin(vT)
    if tick() - lastScan > SCAN_INTERVAL then 
        refreshCoinCache() 
    end
    if not hrp then 
        return nil 
    end
    local myPos = hrp.Position 
    local best, bestDist = nil, math.huge
    for i = #coinCache, 1, -1 do
        local c = coinCache[i]
        if not isCoinValid(c) or (vT and vT[c]) then 
            table.remove(coinCache, i)
        else 
            local d = (c.Position - myPos).Magnitude 
            if d < bestDist then 
                bestDist = d 
                best = c 
            end 
        end
    end
    return best
end

local function getCoinTarget(coin) 
    return Vector3.new(coin.Position.X, coin.Position.Y - COIN_OFFSET, coin.Position.Z) 
end

local function flyTo(targetPos, speed)
    if not hrp or not hrp.Parent then 
        return false 
    end
    speed = speed or FLY_SPEED 
    local startPos = hrp.Position 
    local dist = (targetPos - startPos).Magnitude
    if dist < 0.5 then 
        return true 
    end
    local duration = math.max(dist / speed, 0.05) 
    local elapsed = 0 
    local done = false 
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if not (farming or killing) or not hrp or not hrp.Parent then 
            done = true 
            if conn then conn:Disconnect() end 
            return 
        end
        elapsed = elapsed + dt 
        local a = math.clamp(elapsed / duration, 0, 1)
        local s = a < 0.5 and 2*a*a or 1 - (-2*a+2)^2/2
        local nextPos = startPos:Lerp(targetPos, s) 
        hrp.CFrame = CFrame.new(nextPos) 
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        if a >= 1 then 
            done = true 
            if conn then conn:Disconnect() end 
        end
    end)
    while not done do 
        if not (farming or killing) then break end 
        task.wait(0.03) 
    end
    return true
end

