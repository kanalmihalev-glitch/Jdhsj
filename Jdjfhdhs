local function makeSlider(parent, yPos, color, initial, onChange, labelKey, minV, maxV, isFloat)
    minV = minV or 10 
    maxV = maxV or 120 
    local currentVal = initial
    local lbl = Instance.new("TextLabel") 
    lbl.Size = UDim2.new(1, -24, 0, 14) 
    lbl.Position = UDim2.new(0, 14, 0, yPos) 
    lbl.BackgroundTransparency = 1 
    lbl.TextColor3 = C_TEXT_DIM 
    lbl.Font = Enum.Font.Gotham 
    lbl.TextSize = 11 
    lbl.TextXAlignment = Enum.TextXAlignment.Left 
    lbl.ZIndex = 3 
    lbl.Parent = parent
    regFontLbl(lbl, 1)
    local function updateLbl() 
        local base = L[LANG][labelKey] or labelKey 
        if isFloat then 
            lbl.Text = base .. ": " .. string.format("%.1f", currentVal) 
        else 
            lbl.Text = base .. ": " .. currentVal 
        end 
    end
    updateLbl() 
    table.insert(translateCallbacks, updateLbl)
    local bar = Instance.new("Frame") 
    bar.Size = UDim2.new(1, -28, 0, 8) 
    bar.Position = UDim2.new(0, 14, 0, yPos + 18) 
    bar.BackgroundColor3 = C_PANEL2 
    bar.BackgroundTransparency = 0.3 
    bar.BorderSizePixel = 0 
    bar.ZIndex = 3 
    bar.Parent = parent
    local bc = Instance.new("UICorner") 
    bc.CornerRadius = UDim.new(1, 0) 
    bc.Parent = bar
    local initA = (initial - minV) / (maxV - minV)
    local fill = Instance.new("Frame") 
    fill.Size = UDim2.new(initA, 0, 1, 0) 
    fill.BackgroundColor3 = color 
    fill.BorderSizePixel = 0 
    fill.ZIndex = 3 
    fill.Parent = bar
    local fc = Instance.new("UICorner") 
    fc.CornerRadius = UDim.new(1, 0) 
    fc.Parent = fill
    local fg = Instance.new("UIGradient") 
    fg.Color = ColorSequence.new(C_ACCENT, C_ACCENT2) 
    fg.Parent = fill
    local knob = Instance.new("Frame") 
    knob.Size = UDim2.new(0, 16, 0, 16) 
    knob.Position = UDim2.new(initA, -8, 0.5, -8) 
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255) 
    knob.BorderSizePixel = 0 
    knob.ZIndex = 4 
    knob.Parent = bar
    local kc = Instance.new("UICorner") 
    kc.CornerRadius = UDim.new(1, 0) 
    kc.Parent = knob
    local kStroke = Instance.new("UIStroke") 
    kStroke.Color = C_ACCENT 
    kStroke.Thickness = 1.5 
    kStroke.Parent = knob
    local hit = Instance.new("TextButton") 
    hit.Size = UDim2.new(1, -28, 0, 28) 
    hit.Position = UDim2.new(0, 14, 0, yPos + 3) 
    hit.BackgroundTransparency = 1 
    hit.Text = "" 
    hit.ZIndex = 5 
    hit.Active = true 
    hit.Parent = parent
    local dragging2 = false
    local function upd(x) 
        local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1) 
        local raw = minV + a * (maxV - minV) 
        local v 
        if isFloat then 
            v = math.floor(raw / 0.1 + 0.5) * 0.1 
            v = math.clamp(v, minV, maxV) 
        else 
            v = math.floor(raw) 
        end 
        currentVal = v 
        updateLbl() 
        fill.Size = UDim2.new(a, 0, 1, 0) 
        knob.Position = UDim2.new(a, -8, 0.5, -8) 
        onChange(v) 
    end
    hit.InputBegan:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            dragging2 = true 
            upd(input.Position.X) 
        end 
    end)
    hit.InputEnded:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            dragging2 = false 
        end 
    end)
    UserInputService.InputChanged:Connect(function(input) 
        if dragging2 and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then 
            upd(input.Position.X) 
        end 
    end)
end

