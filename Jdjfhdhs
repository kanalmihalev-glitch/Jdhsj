-- === GOD MODE ===
local GOD_HP = 1e15

local function applyGodState()
    if not immortality then 
        return 
    end
    local char = LocalPlayer.Character
    if not char then 
        return 
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then 
        return 
    end
    pcall(function()
        if hum.MaxHealth ~= GOD_HP then 
            hum.MaxHealth = GOD_HP 
        end
        if hum.Health ~= GOD_HP then 
            hum.Health = GOD_HP 
        end
        if hum.BreakJointsOnDeath then 
            hum.BreakJointsOnDeath = false 
        end
    end)
    if not char:FindFirstChild("GodForceField") then
        pcall(function()
            local ff = Instance.new("ForceField")
            ff.Name = "GodForceField" 
            ff.Visible = false 
            ff.Parent = char
        end)
    end
end

local function takeLocalOwnership()
    local char = LocalPlayer.Character
    if not char then 
        return 
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then 
        pcall(function() root:SetNetworkOwner(LocalPlayer) end) 
    end
end

local function startGodMode()
    if immortalConn then 
        immortalConn:Disconnect() 
    end
    if healthConn then 
        healthConn:Disconnect() 
    end
    applyGodState()
    takeLocalOwnership()
    immortalConn = RunService.Heartbeat:Connect(applyGodState)
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            healthConn = hum.HealthChanged:Connect(function(h)
                if immortality and h < GOD_HP then 
                    pcall(function() hum.Health = GOD_HP end) 
                end
            end)
        end
    end
    task.spawn(function()
        while immortality do 
            task.wait(0.1) 
            applyGodState() 
        end
    end)
end

local function stopGodMode()
    if immortalConn then 
        immortalConn:Disconnect() 
        immortalConn = nil 
    end
    if healthConn then 
        healthConn:Disconnect() 
        healthConn = nil 
    end
    local char = LocalPlayer.Character
    if char then
        local ff = char:FindFirstChild("GodForceField")
        if ff then 
            ff:Destroy() 
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then 
            pcall(function() 
                hum.MaxHealth = 100 
                if hum.Health > 100 then hum.Health = 100 end 
            end) 
        end
    end
end

-- === GLOBAL ANTI-AIM (FIXED FOR DELTA) ===
-- Прямое изменение Camera.CFrame вызывает краш в Дельте.
-- Мы оставляем логику вращения персонажа (AlignOrientation), но убираем вмешательство в камеру.
RunService.Stepped:Connect(function(dt)
    if not antiAimEnabled or not LocalPlayer.Character then 
        return 
    end
    local char = LocalPlayer.Character
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum then 
        return 
    end

    hum.AutoRotate = false
    
    if not alignOrientation then
        alignOrientation = Instance.new("AlignOrientation")
        alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
        alignOrientation.RigidityEnabled = true
        alignOrientation.Responsiveness = 200
        local att = Instance.new("Attachment")
        att.Parent = root
        alignOrientation.Attachment0 = att
        alignOrientation.Parent = root
    end

    if spinEnabled then
        currentSpinAngle = currentSpinAngle + spinSpeed * dt
        alignOrientation.CFrame = CFrame.Angles(0, math.rad(currentSpinAngle), 0)
    elseif backwardsEnabled then
        -- Вращаем персонажа назад, но не трогаем камеру
        alignOrientation.CFrame = CFrame.lookAt(Vector3.zero, -root.CFrame.LookVector)
    else
        alignOrientation.CFrame = CFrame.new()
    end
end)

-- УДАЛЕНО: BindToRenderStep для камеры, так как это главная причина краша в Дельте.
